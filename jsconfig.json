{
    "compilerOptions": {
        "baseUrl": ".",
        "allowJs": true,
        "checkJs": false,
        "jsx": "react-jsx",
        "jsxImportSource": "vue",
        "types": ["vue/jsx"],
        "paths": {
            "@/*": ["resources/js/*"],
            "ziggy-js": ["./vendor/tightenco/ziggy"]
        }
    },
    "include": ["resources/js/**/*.js", "resources/js/**/*.vue"],
    "exclude": ["node_modules", "public"]
}
